#!/usr/bin/env bash
# ja-video-subtitles launcher: uses the project-local .venv Python.
# Does NOT cd into the project: relative input/-o paths resolve against the
# caller's cwd; config.toml and the model cache are resolved by the package
# itself via its own location.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ ! -x "$SCRIPT_DIR/.venv/bin/python" ]]; then
  echo ".venv not found. Set it up first (see README):" >&2
  echo "  cd $SCRIPT_DIR && uv venv --python 3.12 .venv \\" >&2
  echo "    && uv pip install --python .venv/bin/python -r requirements.txt" >&2
  exit 1
fi
export PYTHONPATH="$SCRIPT_DIR${PYTHONPATH:+:$PYTHONPATH}"
exec "$SCRIPT_DIR/.venv/bin/python" -m ja_video_subtitles.cli "$@"
